#!/bin/sh
# Logs every suspend: how long the laptop slept, how much of that time the
# platform reached its deepest idle state (S0ix), and what it cost in battery.
# A healthy sleep shows S0ix above 90% and a drain of a few hundred mW at most.
#
# Installed as /usr/lib/systemd/system-sleep/yoga-sleep-report.
# systemd calls it with:  pre|post  suspend|hibernate|...
# It must never block suspend, so every path ends in "exit 0".

RUN=/run/yoga-sleep
LOG=/var/log/yoga-sleep.log
RES=/sys/devices/system/cpu/cpuidle/low_power_idle_system_residency_us

# Battery energy in micro-watt-hours.
energy_uwh() {
    for b in /sys/class/power_supply/BAT*; do
        [ -d "$b" ] || continue
        if [ -r "$b/energy_now" ]; then
            cat "$b/energy_now"
            return
        fi
        if [ -r "$b/charge_now" ] && [ -r "$b/voltage_now" ]; then
            awk -v c="$(cat "$b/charge_now")" -v v="$(cat "$b/voltage_now")" 'BEGIN { printf "%.0f\n", c * v / 1000000 }'
            return
        fi
    done
    echo 0
}

on_ac() {
    for a in /sys/class/power_supply/A*/online; do
        [ -r "$a" ] && [ "$(cat "$a")" = 1 ] && return 0
    done
    return 1
}

residency() {
    if [ -r "$RES" ]; then cat "$RES"; else echo -1; fi
}

case "$1" in
    pre)
        mkdir -p "$RUN" 2>/dev/null || exit 0
        date +%s > "$RUN/t0"
        residency > "$RUN/r0"
        energy_uwh > "$RUN/e0"
        if on_ac; then echo 1 > "$RUN/ac0"; else echo 0 > "$RUN/ac0"; fi
        ;;
    post)
        [ -r "$RUN/t0" ] || exit 0
        t0=$(cat "$RUN/t0"); r0=$(cat "$RUN/r0"); e0=$(cat "$RUN/e0"); ac0=$(cat "$RUN/ac0")
        t1=$(date +%s); r1=$(residency); e1=$(energy_uwh)
        if on_ac; then ac1=1; else ac1=0; fi

        # $2 is the kind of sleep: suspend, hibernate, suspend-then-hibernate, ...
        line=$(awk -v t0="$t0" -v t1="$t1" -v r0="$r0" -v r1="$r1" -v kind="$2" \
                   -v e0="$e0" -v e1="$e1" -v ac0="$ac0" -v ac1="$ac1" 'BEGIN {
            dt = t1 - t0; if (dt < 1) dt = 1
            if (kind == "hibernate") printf "hibernated"; else printf "slept"
            printf " %dh%02dm%02ds", dt / 3600, (dt % 3600) / 60, dt % 60
            # S0ix only means something for a plain suspend; a hibernated laptop is off.
            if (kind == "hibernate")        printf ""
            else if (kind != "suspend")     printf " (%s)", kind
            else if (r0 >= 0 && r1 >= 0)    printf ", S0ix %.0f%%", (r1 - r0) / (dt * 1000000) * 100
            else                            printf ", S0ix n/a"
            if (ac0 == 1 || ac1 == 1) printf ", on mains power"
            else {
                wh = (e0 - e1) / 1000000
                # A hibernated laptop is off; what it used went into saving and
                # loading the memory image, so an average over the time is meaningless.
                if (kind == "hibernate") printf ", used %.2f Wh to save and restore", wh
                else printf ", used %.2f Wh (%.0f mW average)", wh, wh / (dt / 3600) * 1000
            }
        }')

        echo "$(date '+%F %T')  $line" >> "$LOG" 2>/dev/null
        logger -t yoga-sleep "$line" 2>/dev/null
        rm -f "$RUN/t0" "$RUN/r0" "$RUN/e0" "$RUN/ac0"

        # The charger may have been plugged in or pulled out while asleep.
        systemctl --no-block start yoga-power-auto.service 2>/dev/null
        ;;
esac
exit 0
